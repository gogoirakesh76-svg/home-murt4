# Database connection (SQLite for local preview, PostgreSQL URL for Render/Railway)
DATABASE_URL="file:./dev.db"

# JWT Signing Secret (set a strong 32+ char secret in production)
JWT_SECRET=""

# Admin Panel Credentials (generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 10))")
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# CORS & Deployment URLs
# On Render/Railway backend, set FRONTEND_URL to your Vercel domain (e.g. https://homemurt.vercel.app)
FRONTEND_URL=""
# On Vercel frontend, set VITE_API_URL to your Render/Railway backend URL (leave empty for same-origin)
VITE_API_URL=""
PORT=3000

# APP_URL: Hosted URL injected by AI Studio at runtime
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optional AI Studio runtime key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
